# Configuracion del agente. Se copia a cada equipo.
# En Linux:   /etc/dashboard-connector.env   (chmod 600, root)
# En Windows: variables del servicio (ver IT-03)

# URL del hub. Sin barra final.
DC_HUB_URL=http://IP-DEL-HUB:8700

# Token de agente (el mismo en todos los equipos). Lo da el hub.
DC_AGENT_TOKEN=

# Nombre con el que aparece en el panel. Vacio = nombre del equipo.
DC_NODE_ID=

# Segundos entre latidos (el hub puede sobrescribirlo).
DC_INTERVAL=20

# Cuanto esta dispuesto a ceder este equipo cuando comparte.
# Es informativo para el panel y para quien reparta el trabajo.
DC_SHARE_CPU_PCT=50
DC_SHARE_RAM_MB=2048

# Servicio local que el agente arranca/para segun el modo.
# Vacio = el agente no toca ningun servicio, solo informa y escribe el estado.
DC_WORKER_UNIT=

# Pon 0 solo si el hub usa HTTPS con certificado autofirmado.
DC_VERIFY_TLS=1
