# Copia este fichero a .env y rellena los dos tokens.
# Genera cada uno con:  openssl rand -hex 24
# NO subas el .env al repositorio (ya esta en .gitignore).

# Token que usan los agentes para mandar su latido. Va en todos los equipos.
DC_AGENT_TOKEN=

# Token para entrar al panel y cambiar modos. Solo tu. DEBE ser distinto del anterior.
DC_ADMIN_TOKEN=

# Segundos entre latidos (el hub se lo dice al agente).
DC_POLL_INTERVAL=20

# Interfaz donde escucha el hub. 127.0.0.1 si va detras de un proxy inverso.
DC_BIND=0.0.0.0
